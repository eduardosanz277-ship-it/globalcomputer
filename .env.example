NEXT_PUBLIC_APP_URL=http://localhost:3000
# En Vercel (producción): https://globalcomputer.vercel.app — sin esto, Stripe puede redirigir a localhost.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Clave pública: publishable (sb_publishable_...) o legacy anon (eyJ...) desde Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_EMAIL=admin@globalcomputer.com
ADMIN_PASSWORD=Admin*2026!
ADMIN_FULL_NAME=Administrador
ADMIN_ROLE=ADMIN

# Correo (Resend: https://resend.com — dominio remitente verificado)
# Sin RESEND_API_KEY no se envían emails (solo log en consola).
# Si EMAIL_FROM no está definido, se usa: Global Computers USA <team@globalalarmsusa.online>
RESEND_API_KEY=re_Vej9rMBc_Pbxqv4byyPPVUCSA2NoDZX6C
EMAIL_FROM="Global Computers USA <team@globalalarmsusa.online>"

# Stripe Checkout (página de pago alojada). Dashboard → Developers → API keys
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Opcional: países desde los que se puede pedir envío en Checkout (ISO-2, separados por coma)
# STRIPE_CHECKOUT_SHIPPING_COUNTRIES=ES,PT,FR,DE,IT,US
# Stripe Tax: se envía siempre desde el código; configura impuestos en el Dashboard de Stripe.
# Webhook de Stripe: secret para validar eventos (coincide con el endpoint de webhook).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

