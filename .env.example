NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Clave pública: publishable (sb_publishable_...) o legacy anon (eyJ...) desde Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_EMAIL=admin@globalcomputer.com
ADMIN_PASSWORD=Admin*2026!
ADMIN_FULL_NAME=Administrador
ADMIN_ROLE=ADMIN

# Correo al aprobar cuenta empresa (Resend: https://resend.com — dominio remitente verificado)
# Sin estas variables la aprobación funciona pero no se envía el email (solo log en consola).
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Global Computer <onboarding@tudominio.com>"

